generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// A business is an organisation on the platform. Every business-scoped table
// carries businessId + an index on it. Isolation starts as shared-database /
// shared-schema; isolationTier lets a given business be promoted to a
// dedicated schema/database later without an app rewrite.
model Business {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  isolationTier          String                  @default("shared")
  createdAt              DateTime                @default(now())
  // Profile, collected during onboarding.
  industry               String?
  companySize            String?
  website                String?
  primaryGoal            String?
  onboardingDismissedAt  DateTime?
  // Plan key from PLANS (shared-types/plans.ts); sets the usage limits.
  plan                   String                  @default("starter")
  memberships            Membership[]
  roles                  Role[]
  integrationConnections IntegrationConnection[]
  invitations            Invitation[]
  bots                   Bot[]
  agents                 Agent[]
  agentSkills            AgentSkill[]
  mcpServers             McpServer[]
  knowledgeBases         KnowledgeBase[]
  products               Product[]
  knowledgeDocuments     KnowledgeDocument[]
  knowledgeChunks        KnowledgeChunk[]
  workflows              Workflow[]
  apps                   App[]
  webhookEndpoints       WebhookEndpoint[]
  usageEvents            UsageEvent[]
  auditEvents            AuditEvent[]
  botChannels            BotChannel[]
}

// A user is a single global account. The same user can belong to many
// businesses via Membership, with a different role in each.
model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  name            String?
  createdAt       DateTime         @default(now())
  memberships     Membership[]
  loginChallenges LoginChallenge[]
}

// Second login step: after the password checks out, a short code is emailed
// and must be entered to get a user token. Only the code's hash is stored.
model LoginChallenge {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  lastSentAt DateTime  @default(now())
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// A user's place in one business. role is a built-in role (owner | admin |
// member | viewer — see packages/shared-types/src/business.ts) or the key of
// one of the business's custom Roles.
model Membership {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       String   @default("member")
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
}

// An outstanding invite for an email address to join a business at a given role.
model Invitation {
  id              String   @id @default(uuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email           String
  role            String   @default("member")
  // sha256 of the invite token. The raw token only ever exists in the emailed
  // link, so a database leak can't be used to accept invitations.
  tokenHash       String   @unique
  status          String   @default("pending") // pending | accepted | revoked | expired
  invitedByUserId String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@unique([businessId, email])
  @@index([businessId])
  @@index([email])
}

// A business-defined role. Built-in roles live in code; this table only holds
// custom ones. Membership.role / Invitation.role reference it by key.
model Role {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, key])
  @@index([businessId])
}

// A business's connection to a third-party provider from the integration
// catalog (packages/shared-types/src/integrations.ts). Non-secret fields live
// in config; secret fields are AES-GCM encrypted into secretsEncrypted.
model IntegrationConnection {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider          String
  enabled           Boolean  @default(true)
  config            Json     @default("{}")
  secretsEncrypted  String
  connectedByUserId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([businessId, provider])
  @@index([businessId])
}

model Bot {
  id               String            @id @default(uuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  systemPrompt     String
  model            String            @default("llama3.2:1b")
  mcpServerIds     String[]
  // Connected integrations (provider keys) whose actions this bot can call.
  integrations     String[]          @default([])
  knowledgeBaseIds String[]
  createdAt        DateTime          @default(now())
  // Public embed widget: off by default. widgetKey is a public, revocable
  // identifier (not a secret bearer token) — anyone with it can chat with
  // this bot from an origin in allowedOrigins. Regenerating it invalidates
  // every live embed immediately.
  widgetEnabled    Boolean           @default(false)
  widgetKey        String            @unique @default(uuid())
  allowedOrigins   String[]          @default([])
  // { color, title, greeting, placeholder, position } (see bots.service.ts); null = defaults.
  widgetAppearance Json?
  conversations    BotConversation[]
  channels         BotChannel[]

  @@index([businessId])
}

// One chat with a bot: a widget visitor's session, a playground session, or a
// single message from an old embed that sends no session id. Kept for analytics
// and for reviewing what customers asked.
model BotConversation {
  id              String       @id @default(uuid())
  businessId      String
  botId           String
  bot             Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  source          String // widget | playground
  // Client-generated session id; null when the client sent none.
  sessionKey      String?
  // Page origin the widget ran on.
  origin          String?
  messageCount    Int          @default(0)
  // Replies that couldn't answer, or failed.
  issueCount      Int          @default(0)
  // Set while a team member has taken over a WhatsApp/Telegram chat from the
  // inbox: the bot stays quiet until they hand it back.
  humanTakeoverAt DateTime?
  startedAt       DateTime     @default(now())
  lastMessageAt   DateTime     @default(now())
  messages        BotMessage[]

  @@unique([botId, sessionKey])
  @@index([businessId, startedAt])
  @@index([botId, lastMessageAt])
}

model BotMessage {
  id             String          @id @default(uuid())
  conversationId String
  conversation   BotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | agent (a team member replying from the inbox)
  content        String
  // Assistant only: answered | unanswered (see bot-service chat-log.ts) | error
  outcome        String?
  durationMs     Int?
  createdAt      DateTime        @default(now())

  @@index([conversationId, createdAt])
}

// An internal AI assistant for the business owner/team (not a customer-facing
// embeddable widget like Bot). Same chat shape as Bot but no widget fields.
model Agent {
  id               String              @id @default(uuid())
  businessId       String
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  systemPrompt     String
  // "claude-*" runs on Anthropic (business's Anthropic integration key, else
  // the platform ANTHROPIC_API_KEY); anything else is an Ollama model name.
  model            String              @default("claude-opus-5-5")
  // Built-in tools this agent may call (see apps/bot-service/src/agents/runtime/tools).
  tools            String[]            @default([])
  // Upper bound on model calls per run, so a tool loop can't run away.
  maxSteps         Int                 @default(8)
  // MCP servers whose tools this agent can call (mcp-gateway).
  mcpServerIds     String[]
  // Connected integrations (provider keys) whose actions this agent can call.
  integrations     String[]            @default([])
  knowledgeBaseIds String[]
  // AgentSkills whose instructions and tools are added to this agent's own.
  skillIds         String[]            @default([])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt
  conversations    AgentConversation[]
  runs             AgentRun[]
  schedules        AgentSchedule[]

  @@index([businessId])
}

// A chat thread between one user and one agent. Private to that user.
model AgentConversation {
  id         String         @id @default(uuid())
  businessId String
  agentId    String
  agent      Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId     String
  title      String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  messages   AgentMessage[]
  runs       AgentRun[]

  @@index([businessId, agentId, userId])
}

// One API-shaped message. content is the exact Anthropic content-block array
// (text, tool_use, tool_result, thinking…) so history replays byte-for-byte —
// required for prompt caching and preserved thinking. Tool results are "user"
// messages, exactly as the Messages API expects.
model AgentMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runId          String?
  role           String // "user" | "assistant"
  content        Json
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

// One execution of an agent: a user message (or later, a schedule/API
// trigger) through to the final answer, including every tool call between.
model AgentRun {
  id             String             @id @default(uuid())
  businessId     String
  agentId        String
  agent          Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  userId         String?
  trigger        String             @default("chat") // chat | api | schedule
  // Set for trigger "schedule": the AgentSchedule that fired this run.
  scheduleId     String?
  status         String             @default("running") // running | succeeded | failed
  model          String
  input          String
  output         String?
  error          String?
  inputTokens    Int                @default(0)
  outputTokens   Int                @default(0)
  startedAt      DateTime           @default(now())
  finishedAt     DateTime?
  steps          AgentRunStep[]

  @@index([businessId, startedAt])
  @@index([agentId, startedAt])
  @@index([conversationId])
  @@index([scheduleId, startedAt])
}

// Reusable instructions + built-in tools that any agent can be given.
model AgentSkill {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  instructions String
  tools        String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([businessId])
}

// Runs an agent with a fixed prompt on a schedule. Each firing is a new
// conversation owned by createdById, so the result shows in their chat history.
model AgentSchedule {
  id          String    @id @default(uuid())
  businessId  String
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name        String
  prompt      String
  enabled     Boolean   @default(true)
  // Same shape as a workflow schedule trigger (frequency, time, dayOfWeek, intervalMinutes, timezone).
  trigger     Json
  createdById String
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([businessId])
  @@index([agentId])
}

model AgentRunStep {
  id         String   @id @default(uuid())
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  index      Int
  type       String // "model" | "tool"
  name       String? // tool name, or model id for model steps
  input      Json?
  output     Json?
  isError    Boolean  @default(false)
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([runId, index])
}

// A business's MCP server. "external": the business runs it and we connect to
// endpointUrl as an MCP client. "hosted": the platform serves it — tools are
// defined in McpHostedTool (each wraps an HTTP API) and exposed over MCP at
// /mcp/:id for our agents/bots and outside clients (with the access key).
model McpServer {
  id               String          @id @default(uuid())
  businessId       String
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  mode             String // "hosted" | "external"
  endpointUrl      String?
  // External only: "auto" tries Streamable HTTP, then falls back to legacy SSE.
  transport        String          @default("auto") // auto | streamable_http | sse
  authType         String          @default("none") // none | bearer | header
  authHeaderName   String?
  // External auth secret (bearer token / header value), AES-GCM encrypted.
  secretsEncrypted String?
  // Hosted only: sha256 of the client access key. The key itself is shown once.
  accessKeyHash    String?         @unique
  accessKeyPrefix  String?
  enabled          Boolean         @default(true)
  status           String          @default("pending") // pending | connected | error
  lastError        String?
  lastCheckedAt    DateTime?
  // Last discovered tool list: [{ name, description, inputSchema }].
  tools            Json            @default("[]")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  hostedTools      McpHostedTool[]
  calls            McpToolCall[]

  @@index([businessId])
}

// One tool on a hosted MCP server: calling it makes an HTTP request built from
// a URL template ({{param}} placeholders) and returns the response.
model McpHostedTool {
  id                     String    @id @default(uuid())
  serverId               String
  server                 McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name                   String
  description            String
  // [{ name, type: string|number|integer|boolean, description?, required, enum? }]
  parameters             Json      @default("[]")
  method                 String    @default("GET") // GET | POST | PUT | PATCH | DELETE
  urlTemplate            String
  // Non-secret request headers.
  headers                Json      @default("{}")
  // Secret headers (e.g. Authorization), AES-GCM encrypted JSON object.
  secretHeadersEncrypted String?
  timeoutMs              Int       @default(15000)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([serverId, name])
}

// Every MCP tool call made by the platform — tests from the UI, agents, bots.
model McpToolCall {
  id         String    @id @default(uuid())
  businessId String
  serverId   String
  server     McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  toolName   String
  source     String // test | agent | bot
  userId     String?
  input      Json
  output     Json?
  isError    Boolean   @default(false)
  durationMs Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([serverId, createdAt])
  @@index([businessId, createdAt])
}

model KnowledgeBase {
  id           String              @id @default(uuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  // "crawl": a store's product catalog scraped from sourceUrl.
  // "documents": files, FAQs, text and website pages added as KnowledgeDocuments.
  sourceType   String
  // The store URL to ingest, for sourceType "crawl".
  sourceUrl    String?
  status       String              @default("syncing") // syncing | ready | error
  // Set when status is "error"; e.g. "Could not find any products at that URL."
  errorMessage String?
  productCount Int                 @default(0)
  syncedAt     DateTime?
  // "crawl" only: re-scrape the store on a schedule. daily | weekly | null (off).
  autoSync     String?
  // When the worker's auto-sync sweep should next queue it; null when autoSync is off.
  nextSyncAt   DateTime?
  createdAt    DateTime            @default(now())
  products     Product[]
  documents    KnowledgeDocument[]
  chunks       KnowledgeChunk[]

  @@index([businessId])
}

// One ingested store item: scraped from a KnowledgeBase's sourceUrl, embedded,
// and retrieved by bot-service via knowledge-service's search endpoint.
// `embedding` is Unsupported because Prisma has no native pgvector type —
// writes and similarity search go through raw SQL (see knowledge-service).
model Product {
  id              String                      @id @default(uuid())
  businessId      String
  business        Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase               @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  // The store's own id for this product, for de-duplication on re-sync.
  externalId      String?
  title           String
  description     String?
  price           Float?
  currency        String?
  imageUrl        String?
  productUrl      String
  // Whatever the source tier returned, kept for debugging/re-processing.
  raw             Json?
  embedding       Unsupported("vector(768)")?
  createdAt       DateTime                    @default(now())

  @@unique([knowledgeBaseId, externalId])
  @@index([businessId])
  @@index([knowledgeBaseId])
}

// One source added to a "documents" knowledge base: an uploaded file, an FAQ
// list, pasted text or a website. The worker turns it into KnowledgeChunks.
model KnowledgeDocument {
  id              String           @id @default(uuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  type            String // file | faq | text | website
  title           String
  // website: the start URL. file: unset.
  sourceUrl       String?
  fileName        String?
  mimeType        String?
  // Uploaded file bytes, held only until the worker has extracted the text.
  fileData        Bytes?
  // file/website: filled by the worker. faq/text: set on creation.
  text            String?
  // faq: [{ question, answer }]
  faqItems        Json?
  status          String           @default("processing") // processing | ready | error
  errorMessage    String?
  chunkCount      Int              @default(0)
  // "website" only: re-crawl on a schedule. daily | weekly | null (off).
  autoSync        String?
  nextSyncAt      DateTime?
  createdAt       DateTime         @default(now())
  processedAt     DateTime?
  chunks          KnowledgeChunk[]

  @@index([businessId])
  @@index([knowledgeBaseId])
}

// A passage of a KnowledgeDocument, embedded for retrieval alongside Products.
// `embedding` is Unsupported for the same reason as Product.embedding.
model KnowledgeChunk {
  id              String                      @id @default(uuid())
  businessId      String
  business        Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase               @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  documentId      String
  document        KnowledgeDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position        Int
  content         String
  // Page the passage came from (website documents); else the document title.
  title           String
  sourceUrl       String?
  embedding       Unsupported("vector(768)")?
  createdAt       DateTime                    @default(now())

  @@index([businessId])
  @@index([knowledgeBaseId])
  @@index([documentId])
}

// An automation: one trigger plus ordered steps (see packages/shared-types
// workflow.ts for the JSON shapes). Executed by bot-service's workflow runner.
model Workflow {
  id          String        @id @default(uuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Schedule and webhook triggers only fire while enabled.
  enabled     Boolean       @default(false)
  trigger     Json
  steps       Json          @default("[]")
  // Public, revocable identifier in the webhook URL (like Bot.widgetKey).
  webhookKey  String        @unique @default(uuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  runs        WorkflowRun[]

  @@index([businessId])
}

model WorkflowRun {
  id          String    @id @default(uuid())
  businessId  String
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  trigger     String // manual | webhook | schedule
  status      String    @default("queued") // queued | running | succeeded | failed | stopped
  triggerData Json?
  // WorkflowStepResult[], appended as each step finishes.
  steps       Json      @default("[]")
  error       String?
  // Who pressed "Run now", for manual runs.
  userId      String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([workflowId, startedAt])
  @@index([businessId, startedAt])
}

// A small business app (expenses, tickets, CRM, bookings) run by the app engine
// from its definition, with optional public forms at /a/<slug>.
model App {
  id          String      @id @default(uuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug        String      @unique
  templateKey String?
  name        String
  tagline     String
  icon        String
  color       String
  status      String      @default("live") // live | paused
  // AppDefinition: entities (record types and fields), views, dashboard, public forms, automations.
  definition  Json
  // AppSettings: knowledgeBaseIds, showPoweredBy.
  settings    Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  records     AppRecord[]

  @@index([businessId])
}

// One row of an app's data: an expense, a ticket, a lead, an appointment.
model AppRecord {
  id          String              @id @default(uuid())
  businessId  String
  appId       String
  app         App                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  entity      String
  // Per app and entity, shown with the entity's prefix (T-1024).
  number      Int
  data        Json
  source      String              @default("app") // app | public | sample
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  activities  AppRecordActivity[]

  @@unique([appId, entity, number])
  @@index([appId, entity, createdAt])
}

// A record's timeline: created, field changes, comments.
model AppRecordActivity {
  id        String    @id @default(uuid())
  recordId  String
  record    AppRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type      String // created | updated | comment
  actorId   String?
  actorName String
  detail    Json
  createdAt DateTime  @default(now())

  @@index([recordId, createdAt])
}

// An endpoint of the business's that receives events (outgoing webhooks).
// Deliveries are signed with the secret (Standard Webhooks scheme), which is
// AES-GCM encrypted at rest like integration credentials.
model WebhookEndpoint {
  id                  String            @id @default(uuid())
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url                 String
  description         String?
  // Event types from WEBHOOK_EVENTS (shared-types).
  events              String[]
  enabled             Boolean           @default(true)
  secretEncrypted     String
  // Deliveries that failed every retry in a row; reset by a success.
  consecutiveFailures Int               @default(0)
  // Why the platform turned it off (too many failures), cleared when re-enabled.
  disabledReason      String?
  createdById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveries          WebhookDelivery[]

  @@index([businessId])
}

// One event sent (or being sent) to one endpoint. Kept 30 days.
model WebhookDelivery {
  id             String          @id @default(uuid())
  businessId     String
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  // Same for redeliveries, so receivers can de-duplicate on the webhook-id header.
  eventId        String
  eventType      String
  payload        Json
  status         String          @default("pending") // pending | succeeded | failed
  attempts       Int             @default(0)
  responseStatus Int?
  responseBody   String?
  error          String?
  durationMs     Int?
  nextAttemptAt  DateTime?
  createdAt      DateTime        @default(now())
  lastAttemptAt  DateTime?

  @@index([endpointId, createdAt])
  @@index([businessId, createdAt])
}

// Metering ledger (bot-service usage/meter.ts): one row per AI model call
// ("ai_call", with tokens) and one per bot reply ("bot_reply"). Monthly usage
// and plan limits are computed from it.
model UsageEvent {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type         String // ai_call | bot_reply
  // bot | agent | workflow | app
  feature      String
  model        String?
  provider     String? // anthropic | ollama
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([businessId, createdAt])
}

// Routes a messaging integration (WhatsApp, Telegram) to one bot: customer
// messages arrive on the public webhook /hooks/channels/:webhookKey, the bot
// answers and the reply goes back through the provider. Credentials stay on
// the business's IntegrationConnection; one bot per provider per business.
model BotChannel {
  id            String           @id @default(uuid())
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  botId         String
  bot           Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  provider      String // whatsapp | telegram
  enabled       Boolean          @default(true)
  // Public, revocable identifier in the webhook URL (like Bot.widgetKey).
  webhookKey    String           @unique @default(uuid())
  // WhatsApp: the verify token Meta echoes when subscribing the webhook.
  // Telegram: the secret_token sent back on every update.
  verifyToken   String           @default(uuid())
  messageCount  Int              @default(0)
  lastMessageAt DateTime?
  lastError     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  messages      ChannelMessage[]

  @@unique([businessId, provider])
  @@index([botId])
}

// One message in or out of a channel. Also the bot's short memory: the last
// few messages with the same contact are sent along with each new question.
model ChannelMessage {
  id          String     @id @default(uuid())
  channelId   String
  channel     BotChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  businessId  String
  // WhatsApp number or Telegram chat id.
  contact     String
  contactName String?
  direction   String // in | out
  text        String
  // Provider message id; unique so webhook retries aren't answered twice.
  externalId  String?    @unique
  error       String?
  createdAt   DateTime   @default(now())

  @@index([channelId, contact, createdAt])
  @@index([channelId, createdAt])
}

// Who changed what (see @platform/database audit.ts): written for successful
// changes members make through the dashboard/API, plus sign-ins and joins.
model AuditEvent {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Null for the platform itself.
  actorId      String?
  // Name or email when it happened, so the log still reads after someone leaves.
  actorName    String?
  // "<resourceType>.<verb>", e.g. "bot.updated", "member.removed".
  action       String
  resourceType String
  resourceId   String?
  resourceName String?
  // Field names that changed, plus values for a few safe fields (role, plan, enabled…).
  details      Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, resourceType, createdAt])
  @@index([businessId, actorId, createdAt])
}

# Copy to .env and fill in for local development.
# docker compose -f infra/docker-compose.yml up -d provides the defaults below.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/platform
REDIS_URL=redis://localhost:6380
JWT_SECRET=dev-secret-change-me
# Encrypts integration credentials at rest. Falls back to JWT_SECRET if unset;
# set a separate long random value in production and never rotate it casually
# (existing connections become undecryptable).
INTEGRATIONS_ENCRYPTION_KEY=

# LLM provider for bot orchestration (see docs/ARCHITECTURE.md — AI layer)
ANTHROPIC_API_KEY=
# Suuper's own OpenAI / Gemini keys, used by businesses that haven't added their
# own under Settings → AI Models (calls on a business's own key aren't counted
# toward its plan's AI tokens). Leave empty to require the business's key.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local, free embeddings + chat model runtime for the product-recommendation
# bot flow (see docs/ARCHITECTURE.md — AI/MCP layer). Requires the models to
# be pulled once: `docker compose -f infra/docker-compose.yml exec ollama
# ollama pull nomic-embed-text` and `... ollama pull llama3.2:3b`.
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b

# Per-service port overrides (defaults are baked into each service's main.ts)
# PORT=3000

# api-gateway serves the built embed widget bundle (apps/widget) at /widget.js.
# Defaults to ../widget/dist/widget.js relative to api-gateway's cwd — only set
# this if you're running api-gateway from somewhere else.
# WIDGET_JS_PATH=

# Outgoing email (identity-service: login codes, later invites). Port 465 uses
# implicit TLS; 587 uses STARTTLS. Leave SMTP_HOST empty locally to print
# emails to the identity-service console instead of sending them.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your App <hello@example.com>"
# Local dev only: print every email (incl. login codes) and don't fail on
# undeliverable addresses (seeded @acme.test users). Never in production.
MAIL_LOG=false

# Base URL of the web app, used for links in emails (e.g. invitations) and apps' public pages.
WEB_APP_URL=http://localhost:3200

# MCP: public URL of api-gateway (shown as hosted MCP endpoints), and a
# local-dev-only switch letting MCP servers/hosted tools call localhost/private
# networks. Keep false in production (SSRF risk).
PUBLIC_API_URL=http://localhost:3010
MCP_ALLOW_PRIVATE_URLS=false

# Billing (Settings → Billing) through Stripe. Leave empty to change plans
# directly without payment (local development). Prices are monthly recurring
# prices in your Stripe account; the webhook endpoint is
# <PUBLIC_API_URL>/hooks/billing/stripe, listening for checkout.session.completed,
# customer.subscription.* and invoice.paid / invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# "Sign in with Google": the OAuth client ID from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID -> Web application).
# Leave empty to turn Google sign-in off. Must match the web app's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- Integration OAuth ("Connect with …" on the Integrations page) ---
# Create an OAuth app with each provider and register this redirect URL:
#   <WEB_APP_URL>/oauth/callback   (locally http://localhost:3200/oauth/callback)
# A provider only shows "Connect with …" when both its variables are set;
# the manual credentials form always stays available.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
# The Slack app's signing secret (verifies Slack's requests to us)
SLACK_SIGNING_SECRET=
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
AIRTABLE_OAUTH_CLIENT_ID=
AIRTABLE_OAUTH_CLIENT_SECRET=
ASANA_OAUTH_CLIENT_ID=
ASANA_OAUTH_CLIENT_SECRET=
CLICKUP_OAUTH_CLIENT_ID=
CLICKUP_OAUTH_CLIENT_SECRET=
CALENDLY_OAUTH_CLIENT_ID=
CALENDLY_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
PIPEDRIVE_OAUTH_CLIENT_ID=
PIPEDRIVE_OAUTH_CLIENT_SECRET=
# Jira (Atlassian 3LO app)
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
SHOPIFY_OAUTH_CLIENT_ID=
SHOPIFY_OAUTH_CLIENT_SECRET=
DROPBOX_OAUTH_CLIENT_ID=
DROPBOX_OAUTH_CLIENT_SECRET=
INTERCOM_OAUTH_CLIENT_ID=
INTERCOM_OAUTH_CLIENT_SECRET=
SQUARE_OAUTH_CLIENT_ID=
SQUARE_OAUTH_CLIENT_SECRET=

# --- WhatsApp "Continue with Facebook" (Meta Embedded Signup) ---
# A Meta app with Facebook Login for Business + the WhatsApp product, approved for
# whatsapp_business_management and whatsapp_business_messaging (Tech Provider).
# WHATSAPP_SIGNUP_CONFIG_ID is the Facebook Login for Business configuration
# (type "WhatsApp Embedded Signup"). Add the web app's domain to the app's
# allowed domains for the JavaScript SDK. Without these, WhatsApp keeps the manual form.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_SIGNUP_CONFIG_ID=
# Optional, defaults to v23.0
META_GRAPH_VERSION=

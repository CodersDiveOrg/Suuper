# Production .env for infra/docker-compose.prod.yml. On the server:
#   cp infra/production.env.example .env && chmod 600 .env
# Generate secrets with: openssl rand -hex 32
# DATABASE_URL, REDIS_URL, OLLAMA_URL and service URLs are set by the compose file.

# Images built by GitHub Actions (lowercase owner)
API_IMAGE=ghcr.io/<github-owner>/ai-automation-platform
WEB_IMAGE=ghcr.io/<github-owner>/ai-automation-platform-web
IMAGE_TAG=latest

POSTGRES_PASSWORD=
JWT_SECRET=
# Never rotate casually: existing integration credentials become undecryptable.
INTEGRATIONS_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=

OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:1b

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_LOG=false

WEB_APP_URL=https://app.suuper.cc
PUBLIC_API_URL=https://app.suuper.cc/api
MCP_ALLOW_PRIVATE_URLS=false
